<!DOCTYPE html>
<html lang="en" data-theme="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admins — Meridian</title>
  <link rel="stylesheet" href="/css/style.css" />
  <script>(function(){var s=localStorage.getItem('meridian-theme'),p=window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.setAttribute('data-theme',s||(p?'dark':'light'));})();</script>
</head>
<body>
<div class="admin-shell">

  <aside class="admin-sidebar">
    <a href="/admin" class="sidebar-brand">⚙ Meridian Admin</a>
    <a href="/admin">Content</a>
    <a href="/admin/users" class="active">Admins</a>
    <a href="/en/" target="_blank">View site (EN)</a>
    <a href="/pt/" target="_blank">View site (PT)</a>
    <div class="sidebar-bottom">
      <span><%= user.name || user.email %></span><br>
      <form action="/auth/logout" method="POST" style="display:inline;">
        <button type="submit" style="background:none;border:none;color:var(--subtle);cursor:pointer;font-size:.8rem;padding:0;">Sign out</button>
      </form>
    </div>
  </aside>

  <main class="admin-main">
    <div class="admin-header">
      <h1>Admin users</h1>
      <p>People who can sign in and edit site content.</p>
    </div>

    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.msg %></div>
    <% } %>

    <!-- Add admin -->
    <div class="admin-section" style="margin-bottom:1.5rem;">
      <div class="admin-section-header open" onclick="this.classList.toggle('open');this.querySelector('.chevron').textContent=this.classList.contains('open')?'▲':'▼';this.nextElementSibling.classList.toggle('open')">
        <h2>Add admin</h2><span class="chevron">▲</span>
      </div>
      <div class="admin-section-body open">
        <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;">Enter the Google account email. The person will get access as soon as they sign in with that account.</p>
        <form action="/admin/users" method="POST" style="display:flex;gap:.75rem;flex-wrap:wrap;">
          <div style="flex:1;min-width:220px;">
            <input type="email" name="email" placeholder="name@gmail.com" required style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:.6rem .85rem;font-size:.9rem;color:var(--text);font-family:inherit;" />
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Add admin</button>
        </form>
      </div>
    </div>

    <!-- Admin list -->
    <div class="admin-section">
      <div class="admin-section-header open" onclick="this.classList.toggle('open');this.querySelector('.chevron').textContent=this.classList.contains('open')?'▲':'▼';this.nextElementSibling.classList.toggle('open')">
        <h2>Current admins (<%= admins.length %>)</h2><span class="chevron">▲</span>
      </div>
      <div class="admin-section-body open" style="padding:0;">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Email</th>
              <th>Name</th>
              <th>Added by</th>
              <th>Added</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% admins.forEach(function(admin) { %>
            <tr>
              <td class="email"><%= admin.email %><% if (admin.email === user.email) { %> <span style="font-size:.7rem;color:var(--accent);">(you)</span><% } %></td>
              <td><%= admin.name || '—' %></td>
              <td><%= admin.added_by || 'seed' %></td>
              <td><%= admin.added_at ? admin.added_at.slice(0, 10) : '—' %></td>
              <td style="text-align:right;">
                <% if (admin.email !== user.email) { %>
                <form action="/admin/users/<%= admin.id %>/remove" method="POST" onsubmit="return confirm('Remove <%= admin.email %>?')">
                  <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script src="/js/theme.js"></script>
</body>
</html>
