<!DOCTYPE html>
<html lang="en" data-theme="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Meridian</title>
  <link rel="stylesheet" href="/css/style.css" />
  <script>(function(){var s=localStorage.getItem('meridian-theme'),p=window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.setAttribute('data-theme',s||(p?'dark':'light'));})();</script>
</head>
<body>
<div class="admin-shell">

  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <a href="/admin" class="sidebar-brand">⚙ Meridian Admin</a>
    <a href="/admin" class="active">Content</a>
    <a href="/admin/users">Admins</a>
    <a href="/en/" target="_blank">View site (EN)</a>
    <a href="/pt/" target="_blank">View site (PT)</a>
    <div class="sidebar-bottom">
      <span><%= user.name || user.email %></span><br>
      <form action="/auth/logout" method="POST" style="display:inline;">
        <button type="submit" style="background:none;border:none;color:var(--subtle);cursor:pointer;font-size:.8rem;padding:0;">Sign out</button>
      </form>
    </div>
  </aside>

  <!-- Main -->
  <main class="admin-main">
    <div class="admin-header">
      <h1>Content</h1>
      <p>Edit site content per language. Changes take effect immediately.</p>
    </div>

    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.msg %></div>
    <% } %>

    <!-- ── Config ──────────────────────────────────────────────────────── -->
    <div class="admin-section" id="config">
      <div class="admin-section-header open" onclick="toggleSection(this)">
        <h2>Config — prices, URLs, email</h2>
        <span class="chevron">▲</span>
      </div>
      <div class="admin-section-body open">
        <form action="/admin/config" method="POST">
          <div class="field-row">
            <div class="field-group"><label>Base price</label><input type="text" name="base_price" value="<%= cfg.base_price %>" /></div>
            <div class="field-group"><label>Full price</label><input type="text" name="full_price" value="<%= cfg.full_price %>" /></div>
          </div>
          <div class="field-row">
            <div class="field-group"><label>Base price note</label><input type="text" name="base_price_note" value="<%= cfg.base_price_note %>" /></div>
            <div class="field-group"><label>Full price note</label><input type="text" name="full_price_note" value="<%= cfg.full_price_note %>" /></div>
          </div>
          <div class="field-group"><label>Download URL</label><input type="text" name="download_url" value="<%= cfg.download_url %>" /></div>
          <div class="field-row">
            <div class="field-group"><label>Base buy URL</label><input type="text" name="base_buy_url" value="<%= cfg.base_buy_url %>" /></div>
            <div class="field-group"><label>Full buy URL</label><input type="text" name="full_buy_url" value="<%= cfg.full_buy_url %>" /></div>
          </div>
          <div class="field-group"><label>Support email</label><input type="email" name="support_email" value="<%= cfg.support_email %>" /></div>
          <button type="submit" class="btn btn-primary btn-sm">Save config</button>
        </form>
      </div>
    </div>

    <%
    // Sections with their field definitions
    const sections = [
      { key: 'hero', label: 'Hero', fields: [
        { name: 'eyebrow',       label: 'Eyebrow' },
        { name: 'h1_line1',     label: 'Headline line 1' },
        { name: 'h1_line2',     label: 'Headline line 2' },
        { name: 'subhead',      label: 'Subheadline', multiline: true },
        { name: 'cta_primary',  label: 'Primary CTA' },
        { name: 'cta_secondary',label: 'Secondary CTA' },
      ]},
      { key: 'nav', label: 'Navigation', fields: [
        { name: 'why', label: 'Why Meridian link' },
        { name: 'import', label: 'Import link' },
        { name: 'features', label: 'Features link' },
        { name: 'pricing', label: 'Pricing link' },
        { name: 'download', label: 'Download link' },
      ]},
      { key: 'story', label: 'Story section', fields: [
        { name: 'label',      label: 'Section label' },
        { name: 'title',      label: 'Title' },
        { name: 'p1',         label: 'Paragraph 1', multiline: true },
        { name: 'p2',         label: 'Paragraph 2', multiline: true },
        { name: 'p3',         label: 'Paragraph 3', multiline: true },
        { name: 'card1_title',label: 'Card 1 title' }, { name: 'card1_body', label: 'Card 1 body', multiline: true },
        { name: 'card2_title',label: 'Card 2 title' }, { name: 'card2_body', label: 'Card 2 body', multiline: true },
        { name: 'card3_title',label: 'Card 3 title' }, { name: 'card3_body', label: 'Card 3 body', multiline: true },
      ]},
      { key: 'import_sec', label: 'Import section', fields: [
        { name: 'label', label: 'Label' }, { name: 'title', label: 'Title' }, { name: 'sub', label: 'Subhead', multiline: true },
        { name: 'card1_title', label: 'XLS card title' }, { name: 'card1_body', label: 'XLS card body', multiline: true },
        { name: 'card2_title', label: 'PDF card title' }, { name: 'card2_body', label: 'PDF card body', multiline: true },
        { name: 'card3_title', label: 'TXT card title' }, { name: 'card3_body', label: 'TXT card body', multiline: true },
        { name: 'note', label: 'Bottom note', multiline: true },
      ]},
      { key: 'pricing', label: 'Pricing section', fields: [
        { name: 'label', label: 'Section label' }, { name: 'title', label: 'Title' }, { name: 'sub', label: 'Subhead', multiline: true },
        { name: 'trial_badge', label: 'Trial badge' }, { name: 'trial_price_note', label: 'Trial price note' }, { name: 'trial_cta', label: 'Trial CTA' },
        { name: 'trial_features_yes', label: 'Trial ✓ features', array: true },
        { name: 'trial_features_no',  label: 'Trial ✗ features', array: true },
        { name: 'base_badge', label: 'Base badge' }, { name: 'base_price_note', label: 'Base price note' }, { name: 'base_cta', label: 'Base CTA' },
        { name: 'base_features_yes', label: 'Base ✓ features', array: true },
        { name: 'base_features_no',  label: 'Base ✗ features', array: true },
        { name: 'full_badge', label: 'Full badge' }, { name: 'full_featured_label', label: 'Full featured label' }, { name: 'full_price_note', label: 'Full price note' }, { name: 'full_cta', label: 'Full CTA' },
        { name: 'full_features_yes', label: 'Full ✓ features', array: true },
        { name: 'footnote', label: 'Footnote', multiline: true },
      ]},
      { key: 'download', label: 'Download section', fields: [
        { name: 'label', label: 'Label' }, { name: 'title', label: 'Title' }, { name: 'sub', label: 'Subhead', multiline: true },
        { name: 'windows_label', label: 'Windows card label' }, { name: 'windows_name', label: 'Windows card name' },
      ]},
      { key: 'footer_text', label: 'Footer', fields: [
        { name: 'copyright', label: 'Copyright' }, { name: 'privacy_link', label: 'Privacy link text' }, { name: 'support_link', label: 'Support link text' },
      ]},
    ];
    %>

    <% sections.forEach(function(sec) { %>
    <div class="admin-section" id="<%= sec.key %>">
      <div class="admin-section-header" onclick="toggleSection(this)">
        <h2><%= sec.label %></h2>
        <span class="chevron">▼</span>
      </div>
      <div class="admin-section-body">
        <div class="locale-tabs">
          <button type="button" class="locale-tab active" onclick="switchTab(this, '<%= sec.key %>-en')">EN</button>
          <button type="button" class="locale-tab"        onclick="switchTab(this, '<%= sec.key %>-pt')">PT</button>
        </div>

        <% ['en', 'pt'].forEach(function(lng) { %>
        <div id="<%= sec.key %>-<%= lng %>" class="locale-pane <%= lng === 'en' ? 'active' : '' %>">
          <form action="/admin/content/<%= lng %>/<%= sec.key %>" method="POST">
            <% sec.fields.forEach(function(f) {
              const data = (lng === 'en' ? en : pt)[sec.key] || {};
              const val  = data[f.name];
            %>
              <div class="field-group">
                <label><%= f.label %></label>
                <% if (f.array) { %>
                  <div class="array-field" id="af-<%= lng %>-<%= sec.key %>-<%= f.name %>">
                    <% (Array.isArray(val) ? val : []).forEach(function(item, idx) { %>
                      <div class="array-row">
                        <input type="text" name="<%= f.name %>" value="<%= item %>" />
                        <button type="button" class="remove-row" onclick="removeRow(this)">×</button>
                      </div>
                    <% }); %>
                  </div>
                  <button type="button" class="add-row" onclick="addRow('af-<%= lng %>-<%= sec.key %>-<%= f.name %>', '<%= f.name %>')">+ Add item</button>
                <% } else if (f.multiline) { %>
                  <textarea name="<%= f.name %>"><%= val || '' %></textarea>
                <% } else { %>
                  <input type="text" name="<%= f.name %>" value="<%= val || '' %>" />
                <% } %>
              </div>
            <% }); %>
            <button type="submit" class="btn btn-primary btn-sm">Save <%= lng.toUpperCase() %></button>
          </form>
        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>

  </main>
</div>

<script src="/js/theme.js"></script>
<script>
function toggleSection(header) {
  header.classList.toggle('open');
  header.querySelector('.chevron').textContent = header.classList.contains('open') ? '▲' : '▼';
  header.nextElementSibling.classList.toggle('open');
}

function switchTab(btn, paneId) {
  const tabs  = btn.parentElement.querySelectorAll('.locale-tab');
  const panes = btn.closest('.admin-section-body').querySelectorAll('.locale-pane');
  tabs.forEach(t  => t.classList.remove('active'));
  panes.forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(paneId).classList.add('active');
}

function addRow(containerId, fieldName) {
  const container = document.getElementById(containerId);
  const row = document.createElement('div');
  row.className = 'array-row';
  row.innerHTML = '<input type="text" name="' + fieldName + '" /><button type="button" class="remove-row" onclick="removeRow(this)">×</button>';
  container.appendChild(row);
  row.querySelector('input').focus();
}

function removeRow(btn) {
  btn.closest('.array-row').remove();
}
</script>
</body>
</html>
