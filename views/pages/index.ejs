        <p><%= c.privacy_sec.card1_body %></p>
        <ul><% c.privacy_sec.card1_items.forEach(function(item) { %><li><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= item %></li><% }); %></ul>
      </div>
      <div class="privacy-card">
        <div class="card-icon-sm"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg></div>
        <h3><%= c.privacy_sec.card2_title %></h3>
        <p><%= c.privacy_sec.card2_body %></p>
        <ul><% c.privacy_sec.card2_items.forEach(function(item) { %><li><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= item %></li><% }); %></ul>
      </div>
      <div class="privacy-card">
        <div class="card-icon-sm"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg></div>
        <h3><%= c.privacy_sec.card3_title %></h3>
        <p><%= c.privacy_sec.card3_body %></p>
        <ul><% c.privacy_sec.card3_items.forEach(function(item) { %><li><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= item %></li><% }); %></ul>
      </div>
    </div>
    <p class="privacy-tagline"><%= c.privacy_sec.tagline %></p>
  </div>
</section>

<!-- Finance -->
