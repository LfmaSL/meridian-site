<!-- Privacy section -->
<section id="privacy" style="background: var(--surface);">
  <div class="section-inner">
    <p class="section-label"><%= c.privacy_sec.label %></p>
    <h2 class="section-title"><%= c.privacy_sec.title %></h2>
    <p class="section-sub"><%= c.privacy_sec.sub %></p>
    <div class="privacy-trio">
      <div class="privacy-card">
        <div class="card-icon-sm"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/></svg></div>
