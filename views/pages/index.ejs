      <div class="auto-card"><div class="card-icon-sm"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5"/></svg></div><h3><%= c.automations.card4_title %></h3><p><%= c.automations.card4_body %></p><span class="ac-tier full"><%= c.automations.card4_tier %></span></div>
    </div>
  </div>
</section>

<!-- Full tier spotlight -->
<section id="full" style="background: var(--surface);">
  <div class="section-inner">
    <p class="section-label"><%= c.full_tier.label %></p>
    <h2 class="section-title"><%= c.full_tier.title %></h2>
    <p class="section-sub"><%= c.full_tier.sub %></p>
    <div class="spotlight-box">
      <div class="spotlight-grid">
        <div class="spotlight-features">
          <div class="spotlight-item"><div class="si-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/></svg></div><div><h3><%= c.full_tier.item1_title %></h3><p><%= c.full_tier.item1_body %></p></div></div>
          <div class="spotlight-item"><div class="si-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5"/></svg></div><div><h3><%= c.full_tier.item2_title %></h3><p><%= c.full_tier.item2_body %></p></div></div>
          <div class="spotlight-item"><div class="si-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/></svg></div><div><h3><%= c.full_tier.item3_title %></h3><p><%= c.full_tier.item3_body %></p></div></div>
          <div class="spotlight-item"><div class="si-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/></svg></div><div><h3><%= c.full_tier.item4_title %></h3><p><%= c.full_tier.item4_body %></p></div></div>
        </div>
        <div>
          <p class="coming-section-label"><%= c.full_tier.coming_label %></p>
          <div class="coming-grid">
            <div class="coming-item"><div class="coming-header"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg><h3><%= c.full_tier.coming1_title %></h3><span class="badge-soon"><%= locale === 'pt' ? 'Em breve' : 'Coming soon' %></span></div><p><%= c.full_tier.coming1_body %></p></div>
            <div class="coming-item"><div class="coming-header"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg><h3><%= c.full_tier.coming2_title %></h3><span class="badge-soon"><%= locale === 'pt' ? 'Em breve' : 'Coming soon' %></span></div><p><%= c.full_tier.coming2_body %></p></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pricing -->
<section id="pricing">
  <div class="section-inner">
    <p class="section-label"><%= c.pricing.label %></p>
    <h2 class="section-title"><%= c.pricing.title %></h2>
    <p class="section-sub"><%= c.pricing.sub %></p>
    <div class="pricing-grid">

      <!-- Trial -->
      <div class="pricing-card">
        <p class="tier"><%= c.pricing.trial_badge %></p>
        <p class="price"><%= c.pricing.trial_price %></p>
        <p class="price-note"><%= c.pricing.trial_price_note %></p>
        <ul>
          <% c.pricing.trial_features_yes.forEach(function(f) { %><li class="yes"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= f %></li><% }); %>
          <% c.pricing.trial_features_no.forEach(function(f)  { %><li class="no"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg><%= f %></li><% }); %>
        </ul>
        <a href="<%= cfg.download_url %>" class="btn btn-outline" style="width:100%;text-align:center;"><%= c.pricing.trial_cta %></a>
      </div>

      <!-- Base -->
      <div class="pricing-card">
        <p class="tier"><%= c.pricing.base_badge %></p>
        <p class="price"><%= cfg.base_price %></p>
        <p class="price-note"><%= c.pricing.base_price_note %></p>
        <ul>
          <% c.pricing.base_features_yes.forEach(function(f) { %><li class="yes"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= f %></li><% }); %>
          <% c.pricing.base_features_no.forEach(function(f)  { %><li class="no"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg><%= f %></li><% }); %>
        </ul>
        <a href="<%= cfg.base_buy_url %>" class="btn btn-outline" style="width:100%;text-align:center;"><%= c.pricing.base_cta %> — <%= cfg.base_price %></a>
      </div>

      <!-- Full -->
      <div class="pricing-card featured">
        <div class="badge-featured"><%= c.pricing.full_featured_label %></div>
        <p class="tier accent"><%= c.pricing.full_badge %></p>
        <p class="price"><%= cfg.full_price %></p>
        <p class="price-note"><%= c.pricing.full_price_note %></p>
        <ul>
          <% c.pricing.full_features_yes.forEach(function(f) { %><li class="yes"><svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg><%= f %></li><% }); %>
        </ul>
        <a href="<%= cfg.full_buy_url %>" class="btn btn-primary" style="width:100%;text-align:center;"><%= c.pricing.full_cta %> — <%= cfg.full_price %>/<%= locale === 'pt' ? 'ano' : 'year' %></a>
      </div>

    </div>
    <p class="pricing-footnote">
      <% c.pricing.footnote.split('\n').forEach(function(line, i) { %>
        <% if (i > 0) { %><br /><% } %><%= line %>
      <% }); %>
    </p>
  </div>
</section>

<!-- Download -->
<section id="download" style="background: var(--surface);">
  <div class="section-inner">
    <p class="section-label"><%= c.download.label %></p>
    <h2 class="section-title"><%= c.download.title %></h2>
    <p class="section-sub"><%= c.download.sub %></p>
    <div class="download-grid">
      <a href="<%= cfg.download_url %>" class="download-card">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3"/></svg>
        <div>
          <div class="dl-label"><%= c.download.windows_label %></div>
          <div class="dl-name"><%= c.download.windows_name %></div>
        </div>
      </a>
    </div>
  </div>
</section>

<%- include('../partials/footer', { locale, c, cfg, supported, page: '' }) %>
