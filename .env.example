# Google OAuth — create credentials at console.cloud.google.com
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Random string for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# First admin email — bootstrapped into the admins table on first run
ADMIN_SEED_EMAIL=you@gmail.com

# Public base URL (no trailing slash)
BASE_URL=http://localhost:3000

PORT=3000

# Optional: path to SQLite DB file (default: ./data/meridian.db)
# DB_PATH=/data/meridian.db
